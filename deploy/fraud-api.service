[Unit]
Description=Fraud Detection ML API Container
After=docker.service
Requires=docker.service

[Service]
Restart=always
ExecStart=/usr/bin/docker run --rm --name fraud-api-server -p 8000:8000 fraud-detection-api
ExecStop=/usr/bin/docker stop fraud-api-server

[Install]
WantedBy=multi-user.target
